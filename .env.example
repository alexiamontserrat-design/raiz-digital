# Cadena de conexión a PostgreSQL local (reemplazar con credenciales propias en .env.local)
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://usuario:contrasena_aqui@localhost:5432/raiz_digital"

# Clave secreta para cifrado y firma de sesiones JWT con Auth.js / NextAuth
# Generar con: npx auth secret o openssl rand -base64 33
AUTH_SECRET="cambiar_por_un_secreto_seguro_generado_en_produccion"



